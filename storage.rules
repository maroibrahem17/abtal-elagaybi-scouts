rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validImageUpload() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    function validAudioUpload() {
      return request.resource != null
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType in ['audio/mpeg', 'audio/mp4', 'audio/wav', 'audio/ogg'];
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && validImageUpload();
      allow delete: if isAdmin();
    }

    match /gallery/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && validImageUpload();
      allow delete: if isAdmin();
    }

    match /chants/audio/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && validAudioUpload();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
